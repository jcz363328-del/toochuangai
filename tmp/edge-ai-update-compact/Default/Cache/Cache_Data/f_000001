<script>
    function _logMenuClick(menu, href) {
        const payload = JSON.stringify({menu: menu || '', href: href || ''});
        try {
            if (navigator.sendBeacon) {
                const blob = new Blob([payload], {type: 'application/json'});
                navigator.sendBeacon('/api/menu_click', blob);
                return;
            }
        } catch (e) {}
        try {
            fetch('/api/menu_click', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: payload,
                keepalive: true
            }).catch(() => {});
        } catch (e) {}
    }

    function bindClickableElements() {
        document.querySelectorAll('[data-href][data-menu]').forEach(el => {
            const href = (el.getAttribute('data-href') || '').trim();
            const menu = (el.getAttribute('data-menu') || '').trim();
            if (!href) return;
            el.addEventListener('click', function() {
                if (menu) _logMenuClick(menu, href);
                window.location.href = href;
            });
        });
    }

    function bindSearch() {
        const input = document.getElementById('featureSearch');
        if (!input) return;
        input.addEventListener('input', function() {
            const key = String(input.value || '').toLowerCase().trim();
            document.querySelectorAll('[data-search]').forEach(el => {
                const text = String(el.getAttribute('data-search') || '').toLowerCase();
                if (!key || text.includes(key)) {
                    el.classList.remove('hidden-by-search');
                } else {
                    el.classList.add('hidden-by-search');
                }
            });
        });
    }

    function bindIdentitySwitcher() {
        const trigger = document.getElementById('identitySwitchTrigger');
        const modal = document.getElementById('identitySwitchModal');
        if (!trigger || !modal) return;

        const closeBtn = document.getElementById('identitySwitchClose');
        const cancelBtn = document.getElementById('identitySwitchCancel');
        const confirmBtn = document.getElementById('identitySwitchConfirm');
        const restoreBtn = document.getElementById('identityRestoreBtn');
        const input = document.getElementById('identityMemberSearch');
        const results = document.getElementById('identitySearchResults');
        const status = document.getElementById('identitySwitchStatus');
        let selectedMember = null;
        let searchTimer = null;
        let searchRequestId = 0;

        function setStatus(message, isError) {
            status.textContent = message || '';
            status.classList.toggle('error', !!isError);
        }

        function setEmpty(message) {
            results.innerHTML = '';
            const empty = document.createElement('div');
            empty.className = 'identity-result-empty';
            empty.textContent = message;
            results.appendChild(empty);
        }

        function selectMember(member, row) {
            selectedMember = member;
            results.querySelectorAll('.identity-result').forEach(function(item) {
                item.classList.toggle('selected', item === row);
            });
            input.value = member.name || '';
            confirmBtn.disabled = false;
            setStatus('已选择：' + (member.name || '飞书成员'), false);
        }

        function renderMembers(members) {
            results.innerHTML = '';
            if (!members.length) {
                setEmpty('未找到匹配成员，请输入更完整的姓名');
                return;
            }
            members.forEach(function(member) {
                const row = document.createElement('button');
                row.type = 'button';
                row.className = 'identity-result';

                const avatar = document.createElement('span');
                avatar.className = 'identity-avatar';
                avatar.textContent = String(member.name || '成').slice(0, 1);

                const textWrap = document.createElement('span');
                const name = document.createElement('div');
                name.className = 'identity-result-name';
                name.textContent = member.name || '未命名成员';
                const meta = document.createElement('div');
                meta.className = 'identity-result-meta';
                const memberId = String(member.open_id || '');
                meta.textContent = '飞书成员' + (memberId ? ' · ' + memberId.slice(-6) : '');
                textWrap.appendChild(name);
                textWrap.appendChild(meta);
                row.appendChild(avatar);
                row.appendChild(textWrap);
                row.addEventListener('click', function() { selectMember(member, row); });
                results.appendChild(row);
            });
        }

        function searchMembers() {
            const keyword = String(input.value || '').trim();
            selectedMember = null;
            confirmBtn.disabled = true;
            setStatus('', false);
            if (!keyword) {
                setEmpty('输入姓名后开始搜索飞书成员');
                return;
            }
            const requestId = ++searchRequestId;
            setEmpty('正在搜索…');
            fetch('/api/dashboard/identity-switch/members?q=' + encodeURIComponent(keyword), {
                headers: {'Accept': 'application/json'}
            })
                .then(function(response) {
                    return response.json().then(function(body) {
                        return {ok: response.ok, body: body};
                    });
                })
                .then(function(result) {
                    if (requestId !== searchRequestId) return;
                    if (!result.ok || !result.body || !result.body.success) {
                        throw new Error((result.body && result.body.message) || '搜索失败');
                    }
                    renderMembers(Array.isArray(result.body.data) ? result.body.data : []);
                })
                .catch(function(error) {
                    if (requestId !== searchRequestId) return;
                    setEmpty('成员搜索失败');
                    setStatus(error && error.message ? error.message : '搜索失败，请稍后重试', true);
                });
        }

        function closeModal() {
            modal.classList.remove('open');
            document.body.style.overflow = '';
        }

        trigger.addEventListener('click', function() {
            modal.classList.add('open');
            document.body.style.overflow = 'hidden';
            setTimeout(function() { input.focus(); }, 0);
        });
        closeBtn.addEventListener('click', closeModal);
        cancelBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function(event) {
            if (event.target === modal) closeModal();
        });
        input.addEventListener('input', function() {
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(searchMembers, 260);
        });
        input.addEventListener('keydown', function(event) {
            if (event.key === 'Enter' && selectedMember && !confirmBtn.disabled) {
                event.preventDefault();
                confirmBtn.click();
            }
        });
        confirmBtn.addEventListener('click', function() {
            if (!selectedMember) return;
            const originalText = confirmBtn.textContent;
            confirmBtn.disabled = true;
            confirmBtn.textContent = '切换中…';
            setStatus('正在读取成员权限…', false);
            fetch('/api/dashboard/identity-switch', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
                body: JSON.stringify({
                    user_name: selectedMember.name || '',
                    open_id: selectedMember.open_id || '',
                    selection_token: selectedMember.selection_token || ''
                })
            })
                .then(function(response) {
                    return response.json().then(function(body) {
                        return {ok: response.ok, body: body};
                    });
                })
                .then(function(result) {
                    if (!result.ok || !result.body || !result.body.success) {
                        throw new Error((result.body && result.body.message) || '身份切换失败');
                    }
                    setStatus(result.body.message || '切换成功，正在刷新…', false);
                    window.location.reload();
                })
                .catch(function(error) {
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = originalText;
                    setStatus(error && error.message ? error.message : '身份切换失败，请稍后重试', true);
                });
        });
        if (restoreBtn) {
            restoreBtn.addEventListener('click', function() {
                restoreBtn.disabled = true;
                restoreBtn.textContent = '恢复中…';
                window.location.href = '/permission_debug/clear';
            });
        }
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && modal.classList.contains('open')) closeModal();
        });
    }

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            const panel = document.getElementById('dev-panel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }
    });

    bindClickableElements();
    bindSearch();
    bindIdentitySwitcher();
</script>
</body>
</html>