        tbody tr:hover { background: #edf9f5; }
        th:first-child, td:first-child { text-align: center; }
        .col-id { width: 58px; }
        .col-project { width: 170px; }
        .col-reason { width: 36%; }
        .col-status { width: 78px; }
        .col-date { width: 104px; }
