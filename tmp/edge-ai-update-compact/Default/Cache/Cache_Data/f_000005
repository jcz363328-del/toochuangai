        th, td {
            height: 29px;
            padding: 4px 9px;
            border-bottom: 1px solid #e8edf3;
            text-align: left;
            vertical-align: middle;
            line-height: 20px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        th {
            position: sticky;
            top: 0;
            z-index: 1;
            height: 32px;
            color: #f8fafc;
            background: #24354d;
            border-bottom-color: #24354d;
            font-size: 12px;
            font-weight: 650;
            letter-spacing: .02em;
