<script>
    function _logMenuClick(menu, href) {
        const payload = JSON.stringify({menu: menu || '', href: href || ''});
        try {
            if (navigator.sendBeacon) {
                const blob = new Blob([payload], {type: 'application/json'});
                navigator.sendBeacon('/api/menu_click', blob);
                return;
            }
        } catch (e) {}
        try {
            fetch('/api/menu_click', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: payload,
                keepalive: true
            }).catch(() => {});
        } catch (e) {}
    }

    function bindClickableElements() {
        document.querySelectorAll('[data-href][data-menu]').forEach(el => {
            const href = (el.getAttribute('data-href') || '').trim();
            const menu = (el.getAttribute('data-menu') || '').trim();
            if (!href) return;
            el.addEventListener('click', function() {
                if (menu) _logMenuClick(menu, href);
                window.location.href = href;
            });
        });
    }

    function bindSearch() {
        const input = document.getElementById('featureSearch');
        if (!input) return;
        input.addEventListener('input', function() {
            const key = String(input.value || '').toLowerCase().trim();
            document.querySelectorAll('[data-search]').forEach(el => {
                const text = String(el.getAttribute('data-search') || '').toLowerCase();
                if (!key || text.includes(key)) {
                    el.classList.remove('hidden-by-search');
                } else {
                    el.classList.add('hidden-by-search');
                }
            });
        });
    }

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            const panel = document.getElementById('dev-panel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }
    });

    bindClickableElements();
    bindSearch();
</script>
